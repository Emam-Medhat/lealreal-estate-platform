# ════════════════════════════════════════════════
# AI Integration – Environment Variables
# Add these to your .env file
# ════════════════════════════════════════════════

# ── Active AI Provider ──────────────────────────
AI_PROVIDER=openai

# ── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o

# ── Anthropic (optional fallback) ───────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Google AI ───────────────────────────────────
# GOOGLE_AI_API_KEY=AIza...
# GOOGLE_VISION_API_KEY=AIza...

# ── Azure Computer Vision (optional) ────────────
# AZURE_VISION_API_KEY=...
# AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# ── Price Prediction Microservice ───────────────
PRICE_PREDICTION_URL=http://localhost:8001
PRICE_PREDICTION_API_KEY=your-secret-key

# ── AI Feature Toggles ──────────────────────────
AI_SMART_SEARCH_ENABLED=true
AI_LOG_REQUESTS=true

# ── Image Analysis Provider ─────────────────────
IMAGE_ANALYSIS_PROVIDER=openai   # google | azure | openai

# ── Cost Control ────────────────────────────────
AI_MONTHLY_BUDGET=500

# ── Queue (change to redis for production) ──────
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# ── Cache (change to redis for production) ──────
CACHE_STORE=file
# CACHE_STORE=redis
