<script>
/* ── SIDEBAR TOGGLE ── */
let sidebarCollapsed = false;

function toggleSidebar(){
  const sidebar   = document.getElementById('sidebar');
  const icon      = document.getElementById('toggle-icon');
  const isMobile  = window.innerWidth <= 900;

  if(isMobile){
    sidebar.classList.toggle('mobile-open');
  } else {
    sidebarCollapsed = !sidebarCollapsed;
    sidebar.classList.toggle('collapsed', sidebarCollapsed);
    icon.className = sidebarCollapsed ? 'fas fa-bars' : 'fas fa-bars';
  }
}

/* ── NOTIFICATION DROPDOWN ── */
function toggleNotif(){
  const dd = document.getElementById('notif-dropdown');
  dd.classList.toggle('open');
}
// Close on outside click
document.addEventListener('click', e=>{
  const btn = document.getElementById('notif-btn');
  const dd  = document.getElementById('notif-dropdown');
  if(!btn.contains(e.target) && !dd.contains(e.target)){
    dd.classList.remove('open');
  }
});

function markAllRead(){
  document.querySelectorAll('.nd-item.unread').forEach(item=>{
    item.classList.remove('unread');
    const dot = item.querySelector('.nd-unread-dot');
    if(dot) dot.remove();
  });
  const badge = document.getElementById('notif-badge');
  badge.style.display='none';
  document.querySelector('.nd-head .nd-title span').textContent='';
}

/* ── AUTO-HIDE SESSION MESSAGES ── */
document.addEventListener('DOMContentLoaded',()=>{
  // Session messages would be shown via Laravel session helpers
  // Demo: hide immediately
  ['session-success','session-error'].forEach(id=>{
    const el = document.getElementById(id);
    if(el && el.style.display !== 'none'){
      setTimeout(()=>{ el.style.opacity='0'; setTimeout(()=>el.remove(),400); }, 5000);
    }
  });
});
</script>
</body>
</html>