<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لوحة التحكم — نظام إدارة العقارات</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
/* ═══════════════════════════════════════════════
   ADMIN LAYOUT — Topbar + Sidebar + Footer
   Palette: Blue #0D6EFD · Purple #6F42C1
            Green #198754 · Orange #FD7E14
   Font: Cairo | Direction: RTL
═══════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --blue:    #0D6EFD;  --blue-g:  linear-gradient(135deg,#0D6EFD,#0a58ca);
  --purple:  #6F42C1;  --purple-g:linear-gradient(135deg,#6F42C1,#59359a);
  --green:   #198754;  --orange:  #FD7E14;  --red:#DC3545;
  --navy:    #1E3A8A;  --navy2:   #1D4ED8;  --indigo:#4F46E5;

  --bg:   #F0F4FF;
  --card: #FFFFFF;
  --card2:#F8FAFF;
  --bd:   #E2E8F0;
  --bd2:  #CBD5E1;

  --t1:#1E293B;  --t2:#475569;  --t3:#64748B;  --t4:#94A3B8;

  --r1:8px; --r2:12px; --r3:16px; --r4:22px;
  --sh:    0 1px 4px rgba(0,0,0,.06),0 2px 8px rgba(0,0,0,.04);
  --sh-md: 0 4px 20px rgba(0,0,0,.08),0 2px 8px rgba(0,0,0,.05);
  --sh-lg: 0 10px 40px rgba(0,0,0,.12);
  --tr:    all .22s cubic-bezier(.4,0,.2,1);
  --tr-sp: all .35s cubic-bezier(.34,1.3,.64,1);
  --ff:    'Cairo', system-ui, sans-serif;
}

html,body{height:100%;}
body{
  font-family:var(--ff);background:var(--bg);
  color:var(--t1);direction:rtl;
  display:flex;flex-direction:column;min-height:100vh;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 55% 35% at 85% 5%,rgba(13,110,253,.05) 0%,transparent 55%),
    radial-gradient(ellipse 45% 45% at 5% 90%,rgba(111,66,193,.04) 0%,transparent 55%);
}

/* ═══════════════════════════════════
   LAYOUT SHELL
═══════════════════════════════════ */
.layout{
  display:flex;min-height:100vh;position:relative;z-index:1;
}

/* ═══════════════════════════════════
   SIDEBAR
═══════════════════════════════════ */
.sidebar{
  width:260px;flex-shrink:0;
  background:var(--card);
  border-left:1px solid var(--bd);
  display:flex;flex-direction:column;
  position:sticky;top:0;height:100vh;
  overflow:hidden;
  transition:width .3s cubic-bezier(.4,0,.2,1);
  box-shadow:4px 0 20px rgba(0,0,0,.04);
  z-index:50;
}
.sidebar.collapsed{width:68px;}

/* Sidebar logo */
.sidebar-logo{
  padding:20px 18px;
  border-bottom:1px solid var(--bd);
  display:flex;align-items:center;gap:12px;
  flex-shrink:0;
}
.sl-icon{
  width:40px;height:40px;border-radius:var(--r2);
  background:var(--blue-g);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;color:#fff;flex-shrink:0;
  box-shadow:0 4px 14px rgba(13,110,253,.3);
}
.sl-text{overflow:hidden;transition:opacity .2s,width .3s;}
.sl-name{font-size:14px;font-weight:900;color:var(--t1);white-space:nowrap;}
.sl-sub {font-size:10px;color:var(--t4);font-weight:600;letter-spacing:.04em;white-space:nowrap;}
.sidebar.collapsed .sl-text{opacity:0;width:0;}

/* Sidebar nav */
.sidebar-nav{flex:1;overflow-y:auto;padding:14px 12px;}
.sidebar-nav::-webkit-scrollbar{width:0;}

.nav-section-label{
  font-size:9.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;
  color:var(--t4);padding:6px 8px 4px;
  white-space:nowrap;overflow:hidden;
  transition:opacity .2s;
}
.sidebar.collapsed .nav-section-label{opacity:0;}

.nav-item{
  display:flex;align-items:center;gap:11px;
  padding:10px 12px;border-radius:var(--r2);
  font-size:13.5px;font-weight:600;color:var(--t2);
  cursor:pointer;transition:var(--tr);
  text-decoration:none;margin-bottom:2px;
  position:relative;white-space:nowrap;
  overflow:hidden;
}
.nav-item i{
  font-size:15px;flex-shrink:0;
  width:20px;text-align:center;
  transition:transform .3s;
}
.nav-item:hover{
  background:rgba(13,110,253,.07);
  color:var(--blue);
}
.nav-item:hover i{transform:scale(1.15);}
.nav-item.active{
  background:linear-gradient(135deg,rgba(13,110,253,.12),rgba(13,110,253,.05));
  color:var(--blue);
  border-right:3px solid var(--blue);
}
.nav-item.active i{color:var(--blue);}

/* Nav item text hides on collapse */
.nav-item-text{
  transition:opacity .2s,width .3s;
  overflow:hidden;flex:1;
}
.sidebar.collapsed .nav-item-text{opacity:0;width:0;}

/* Active dot */
.nav-item .nav-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--blue);flex-shrink:0;
  opacity:0;transition:opacity .2s;
}
.nav-item.active .nav-dot{opacity:1;}
.sidebar.collapsed .nav-dot{display:none;}

/* Badge */
.nav-badge{
  font-size:9.5px;font-weight:800;
  background:var(--red);color:#fff;
  padding:1px 7px;border-radius:20px;flex-shrink:0;
}
.sidebar.collapsed .nav-badge{display:none;}

/* Sidebar user footer */
.sidebar-foot{
  padding:14px 12px;border-top:1px solid var(--bd);
  flex-shrink:0;
}
.sidebar-user{
  display:flex;align-items:center;gap:10px;
  padding:10px 10px;border-radius:var(--r2);
  cursor:pointer;transition:var(--tr);
}
.sidebar-user:hover{background:var(--card2);}
.su-av{
  width:36px;height:36px;border-radius:50%;flex-shrink:0;
  background:var(--blue-g);
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;color:#fff;
  border:2px solid var(--bg);box-shadow:0 0 0 1.5px rgba(13,110,253,.25);
}
.su-info{overflow:hidden;transition:opacity .2s,width .3s;}
.su-name{font-size:13px;font-weight:700;color:var(--t1);white-space:nowrap;}
.su-role{font-size:10.5px;color:var(--t4);white-space:nowrap;}
.sidebar.collapsed .su-info{opacity:0;width:0;}

/* ═══════════════════════════════════
   MAIN AREA
═══════════════════════════════════ */
.main-area{
  flex:1;display:flex;flex-direction:column;
  min-width:0;overflow:hidden;
}

/* ═══════════════════════════════════
   TOP BAR
═══════════════════════════════════ */
.topbar{
  background:var(--card);
  border-bottom:1px solid var(--bd);
  padding:0 24px;
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;height:62px;flex-shrink:0;
  position:sticky;top:0;z-index:40;
  box-shadow:var(--sh);
}

/* Left side */
.topbar-left{display:flex;align-items:center;gap:14px;}

/* Toggle btn */
.tb-toggle{
  width:36px;height:36px;border-radius:var(--r1);
  background:var(--card2);border:1px solid var(--bd);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;color:var(--t3);cursor:pointer;
  transition:var(--tr-sp);
}
.tb-toggle:hover{background:rgba(13,110,253,.07);color:var(--blue);border-color:rgba(13,110,253,.2);}

/* Breadcrumb */
.tb-breadcrumb{
  display:flex;align-items:center;gap:8px;
  font-size:12px;color:var(--t4);
}
.tb-breadcrumb a{color:var(--t4);text-decoration:none;transition:color .2s;}
.tb-breadcrumb a:hover{color:var(--blue);}
.tb-breadcrumb-sep{color:var(--bd2);}
.tb-page-title{font-size:16px;font-weight:800;color:var(--t1);}

/* Right side */
.topbar-right{display:flex;align-items:center;gap:8px;}

/* Search */
.tb-search{
  position:relative;
  transition:var(--tr);
}
.tb-search input{
  width:180px;padding:8px 14px 8px 36px;
  border:1.5px solid var(--bd);border-radius:var(--r2);
  font-family:var(--ff);font-size:12.5px;color:var(--t1);
  background:var(--card2);outline:none;
  transition:width .3s,border-color .2s,box-shadow .2s;
}
.tb-search input:focus{
  width:240px;border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(13,110,253,.1);
}
.tb-search-ic{
  position:absolute;left:12px;top:50%;transform:translateY(-50%);
  font-size:12px;color:var(--t4);pointer-events:none;
}

/* Icon buttons */
.tb-icon-btn{
  width:38px;height:38px;border-radius:var(--r2);
  border:1.5px solid var(--bd);background:var(--card2);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;color:var(--t3);cursor:pointer;
  transition:var(--tr-sp);position:relative;
}
.tb-icon-btn:hover{
  background:rgba(13,110,253,.07);
  color:var(--blue);border-color:rgba(13,110,253,.22);
  transform:translateY(-1px);
}

/* Notification badge */
.tb-notif-badge{
  position:absolute;top:-4px;right:-4px;
  width:18px;height:18px;border-radius:50%;
  background:var(--red);color:#fff;
  font-size:9px;font-weight:800;
  display:flex;align-items:center;justify-content:center;
  border:2px solid var(--card);
  animation:badgeping 2s ease-in-out infinite;
}
@keyframes badgeping{0%,100%{box-shadow:0 0 0 0 rgba(220,53,69,.4)}60%{box-shadow:0 0 0 6px rgba(220,53,69,0)}}

/* NOTIFICATION DROPDOWN */
.notif-dropdown{
  position:absolute;
  top:calc(100% + 10px);
  left:0;
  width:340px;
  background:var(--card);
  border:1px solid var(--bd);
  border-radius:var(--r3);
  box-shadow:var(--sh-lg);
  z-index:999;
  overflow:hidden;
  opacity:0;transform:translateY(-8px) scale(.97);
  pointer-events:none;
  transition:opacity .22s,transform .22s;
}
.notif-dropdown.open{
  opacity:1;transform:translateY(0) scale(1);pointer-events:all;
}
.nd-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 16px;border-bottom:1px solid var(--bd);
  background:var(--card2);
}
.nd-title{font-size:13.5px;font-weight:800;color:var(--t1);}
.nd-mark-all{
  font-size:11px;font-weight:700;color:var(--blue);
  background:none;border:none;cursor:pointer;font-family:var(--ff);
  transition:color .2s;
}
.nd-mark-all:hover{color:var(--navy2);}

.nd-list{max-height:320px;overflow-y:auto;}
.nd-list::-webkit-scrollbar{width:3px;}
.nd-list::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:10px;}

/* Notif item */
.nd-item{
  display:flex;align-items:flex-start;gap:12px;
  padding:12px 16px;border-bottom:1px solid var(--bd);
  cursor:pointer;transition:background .18s;
  position:relative;
}
.nd-item:hover{background:var(--card2);}
.nd-item.unread{background:rgba(13,110,253,.03);}
.nd-item.unread::before{
  content:'';position:absolute;
  right:0;top:0;bottom:0;width:3px;
  background:var(--blue);
}
.nd-item-ic{
  width:36px;height:36px;border-radius:var(--r1);
  display:flex;align-items:center;justify-content:center;
  font-size:14px;flex-shrink:0;
}
.ni-blue  {background:rgba(13,110,253,.1);  color:var(--blue);}
.ni-green {background:rgba(25,135,84,.1);   color:var(--green);}
.ni-orange{background:rgba(253,126,20,.1);  color:var(--orange);}
.ni-red   {background:rgba(220,53,69,.1);   color:var(--red);}
.ni-purple{background:rgba(111,66,193,.1);  color:var(--purple);}
.nd-item-body{flex:1;min-width:0;}
.nd-item-text{font-size:12.5px;font-weight:600;color:var(--t1);line-height:1.4;margin-bottom:3px;}
.nd-item-time{font-size:10.5px;color:var(--t4);}
.nd-unread-dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--blue);flex-shrink:0;margin-top:5px;
}

.nd-empty{
  display:flex;flex-direction:column;align-items:center;
  padding:36px 20px;
}
.nd-empty i{font-size:28px;color:var(--t4);margin-bottom:10px;opacity:.6;}
.nd-empty-txt{font-size:12.5px;color:var(--t4);}

.nd-foot{
  padding:10px 16px;border-top:1px solid var(--bd);
  background:var(--card2);text-align:center;
}
.nd-see-all{
  font-size:12px;font-weight:700;color:var(--blue);
  text-decoration:none;transition:color .2s;
}
.nd-see-all:hover{color:var(--navy2);}

/* Divider */
.tb-divider{width:1px;height:24px;background:var(--bd);flex-shrink:0;}

/* User button */
.tb-user{
  display:flex;align-items:center;gap:9px;
  padding:6px 10px;border-radius:var(--r2);
  cursor:pointer;transition:var(--tr);border:1.5px solid transparent;
}
.tb-user:hover{background:var(--card2);border-color:var(--bd);}
.tb-user-av{
  width:34px;height:34px;border-radius:50%;
  background:var(--blue-g);
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;color:#fff;flex-shrink:0;
  border:2px solid var(--bg);box-shadow:0 0 0 1.5px rgba(13,110,253,.25);
}
.tb-user-name{font-size:13px;font-weight:700;color:var(--t1);}
.tb-user-role{font-size:10px;color:var(--t4);}
.tb-user-chevron{font-size:10px;color:var(--t4);margin-right:2px;}

/* ═══════════════════════════════════
   PAGE CONTENT AREA
═══════════════════════════════════ */
.page-content{
  flex:1;padding:32px;
  background:var(--bg);
  overflow-y:auto;
}

/* Content wrapper for pages */
.content-wrapper {
  background: var(--card);
  border-radius: var(--r3);
  box-shadow: var(--sh);
  padding: 32px;
  margin-bottom: 24px;
}

/* Page headers */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 2px solid var(--bd);
}

.page-title {
  font-size: 28px;
  font-weight: 800;
  color: var(--t1);
  margin: 0;
}

.page-subtitle {
  font-size: 14px;
  color: var(--t4);
  margin-top: 8px;
}

.page-actions {
  display: flex;
  gap: 12px;
}

.btn-primary {
  background: var(--blue-g);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: var(--r2);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--tr);
  box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
}

.btn-secondary {
  background: var(--card2);
  color: var(--t2);
  border: 2px solid var(--bd);
  padding: 12px 24px;
  border-radius: var(--r2);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--tr);
}

.btn-secondary:hover {
  background: var(--bg);
  border-color: var(--blue);
  color: var(--blue);
}

/* Cards */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin-bottom: 32px;
}

.stat-card {
  background: var(--card);
  border-radius: var(--r3);
  padding: 24px;
  box-shadow: var(--sh);
  border-right: 4px solid transparent;
  transition: var(--tr);
}

.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--sh-md);
}

.stat-card.blue { border-right-color: var(--blue); }
.stat-card.green { border-right-color: var(--green); }
.stat-card.orange { border-right-color: var(--orange); }
.stat-card.red { border-right-color: var(--red); }

.stat-icon {
  width: 56px;
  height: 56px;
  border-radius: var(--r2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 16px;
}

.stat-icon.blue { background: rgba(13, 110, 253, 0.1); color: var(--blue); }
.stat-icon.green { background: rgba(25, 135, 84, 0.1); color: var(--green); }
.stat-icon.orange { background: rgba(253, 126, 20, 0.1); color: var(--orange); }
.stat-icon.red { background: rgba(220, 53, 69, 0.1); color: var(--red); }

.stat-value {
  font-size: 32px;
  font-weight: 800;
  color: var(--t1);
  margin-bottom: 8px;
}

.stat-label {
  font-size: 14px;
  color: var(--t4);
  font-weight: 600;
}

/* Tables */
.table-container {
  background: var(--card);
  border-radius: var(--r3);
  box-shadow: var(--sh);
  overflow: hidden;
}

.table-header {
  padding: 20px 24px;
  background: var(--card2);
  border-bottom: 1px solid var(--bd);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.table-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--t1);
}

.table-actions {
  display: flex;
  gap: 12px;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table th {
  background: var(--card2);
  padding: 16px 24px;
  text-align: right;
  font-size: 12px;
  font-weight: 800;
  color: var(--t4);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 1px solid var(--bd);
}

.data-table td {
  padding: 16px 24px;
  border-bottom: 1px solid var(--bd);
  font-size: 14px;
  color: var(--t2);
}

.data-table tr:hover {
  background: var(--card2);
}

/* Forms */
.form-section {
  background: var(--card);
  border-radius: var(--r3);
  padding: 32px;
  margin-bottom: 24px;
  box-shadow: var(--sh);
}

.form-section-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 24px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--bd);
}

.form-group {
  margin-bottom: 24px;
}

.form-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8px;
}

.form-control {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid var(--bd);
  border-radius: var(--r2);
  font-size: 14px;
  color: var(--t1);
  background: var(--card);
  transition: var(--tr);
}

.form-control:focus {
  outline: none;
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
}

/* Alerts */
.alert {
  padding: 16px 20px;
  border-radius: var(--r2);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  font-weight: 600;
}

.alert-success {
  background: rgba(25, 135, 84, 0.1);
  color: var(--green);
  border: 1px solid rgba(25, 135, 84, 0.2);
}

.alert-error {
  background: rgba(220, 53, 69, 0.1);
  color: var(--red);
  border: 1px solid rgba(220, 53, 69, 0.2);
}

.alert-warning {
  background: rgba(253, 126, 20, 0.1);
  color: var(--orange);
  border: 1px solid rgba(253, 126, 20, 0.2);
}

/* Demo content placeholder */
.demo-placeholder{
  background:var(--card);border:2px dashed var(--bd2);
  border-radius:var(--r3);padding:80px 20px;
  text-align:center;
}
.demo-placeholder i{font-size:48px;color:var(--t4);opacity:.4;display:block;margin-bottom:16px;}
.demo-placeholder h3{font-size:18px;font-weight:700;color:var(--t2);margin-bottom:6px;}
.demo-placeholder p{font-size:13.5px;color:var(--t4);}

/* ═══════════════════════════════════
   FOOTER
═══════════════════════════════════ */
.footer{
  background:var(--card);
  border-top:1px solid var(--bd);
  padding:20px 28px;
  margin-top:28px;
  flex-shrink:0;
}
.footer-inner{
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;flex-wrap:wrap;
}

/* Footer brand */
.footer-brand{display:flex;align-items:center;gap:12px;}
.fb-icon{
  width:38px;height:38px;border-radius:var(--r2);
  background:var(--blue-g);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;color:#fff;flex-shrink:0;
  box-shadow:0 4px 14px rgba(13,110,253,.25);
  transition:var(--tr-sp);
}
.footer-brand:hover .fb-icon{transform:scale(1.08) rotate(-4deg);}
.fb-copy{font-size:12.5px;color:var(--t2);}
.fb-copy strong{color:var(--t1);font-weight:800;}
.fb-rights{font-size:10.5px;color:var(--t4);margin-top:2px;display:flex;align-items:center;gap:5px;}

/* Footer links */
.footer-links{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}

.flink{
  display:flex;align-items:center;gap:8px;
  padding:7px 14px;border-radius:var(--r2);
  background:var(--card2);border:1px solid var(--bd);
  font-size:12px;font-weight:700;color:var(--t2);
  text-decoration:none;cursor:pointer;
  transition:var(--tr-sp);
}
.flink:hover{transform:translateY(-2px);box-shadow:var(--sh-md);}
.flink-ic{
  width:26px;height:26px;border-radius:7px;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;color:#fff;flex-shrink:0;
  transition:transform .3s;
}
.flink:hover .flink-ic{transform:scale(1.1) rotate(6deg);}
.fic-green  {background:linear-gradient(135deg,#198754,#146c43);}
.fic-purple {background:linear-gradient(135deg,#6F42C1,#59359a);}
.fic-orange {background:linear-gradient(135deg,#FD7E14,#dc6a0c);}
.flink:hover{border-color:rgba(13,110,253,.2);color:var(--blue);}

/* Footer version pill */
.footer-right{display:flex;align-items:center;gap:12px;}
.version-pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 14px;border-radius:20px;
  background:var(--blue-g);color:#fff;
  font-size:10.5px;font-weight:800;letter-spacing:.06em;
  box-shadow:0 4px 12px rgba(13,110,253,.22);
}

/* Footer divider */
.footer-divider{width:1px;height:20px;background:var(--bd);flex-shrink:0;}

/* ═══════════════════════════════════
   SESSION MESSAGES
═══════════════════════════════════ */
.session-msg{
  position:fixed;top:20px;left:20px;z-index:9999;
  display:flex;align-items:center;gap:10px;
  padding:12px 20px;border-radius:var(--r2);
  font-family:var(--ff);font-size:13.5px;font-weight:700;
  box-shadow:var(--sh-lg);
  animation:slideInLeft .4s cubic-bezier(.34,1.2,.64,1) forwards;
  border:1px solid;
}
.session-msg.success{background:var(--card);border-color:rgba(25,135,84,.3);color:var(--green);}
.session-msg.error  {background:var(--card);border-color:rgba(220,53,69,.3); color:var(--red);}
@keyframes slideInLeft{from{transform:translateX(-120%);opacity:0}to{transform:translateX(0);opacity:1}}

/* ═══════════════════════════════════
   SCROLLBAR
═══════════════════════════════════ */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:10px}
::-webkit-scrollbar-thumb:hover{background:var(--blue)}

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media(max-width:900px){
  .sidebar{position:fixed;height:100vh;transform:translateX(100%);transition:transform .3s;}
  .sidebar.mobile-open{transform:translateX(0);}
  .tb-search input{width:140px;}
  .footer-links{display:none;}
  .page-content{padding:16px;}
  .footer{padding:14px 16px;}
}
@media(max-width:600px){
  .topbar{padding:0 14px;}
  .tb-user-name,.tb-user-role{display:none;}
  .tb-search{display:none;}
}
</style>
